generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VISITOR
}

enum ServiceType {
  WEB_APP
  BOOKING_SYSTEM
  ECOMMERCE
  AI_AUTOMATION
  OTHER
}

enum PreferredContact {
  EMAIL
  PHONE
  WHATSAPP
}

enum LeadStatus {
  NEW
  REVIEWING
  CONTACTED
  QUALIFIED
  WON
  LOST
  ARCHIVED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(VISITOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  blogPosts     BlogPost[]
  faqs          FAQ[]
  testimonials  Testimonial[]
}

model Site {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  primaryDomain   String?          @unique
  aliases         String[]
  brandConfig     Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projects        Project[]
  blogPosts       BlogPost[]
  faqs            FAQ[]
  testimonials    Testimonial[]
  leads           Lead[]
  contactMessages ContactMessage[]
  chatSessions    ChatSession[]
  analyticsEvents AnalyticsEvent[]
  settings        SiteSetting[]
  notifications   Notification[]

  @@index([slug])
  @@index([primaryDomain])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Project {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  summary          String
  description      String
  problem          String
  solution         String
  outcome          String?
  clientType       String?
  industry         String?
  coverImage       String?
  gallery          String[]
  techStack        String[]
  services         String[]
  liveUrl          String?
  githubUrl        String?
  caseStudyContent String
  featured         Boolean       @default(false)
  published        Boolean       @default(false)
  sortOrder        Int           @default(0)
  authorId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  author           User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sites            Site[]
  testimonials     Testimonial[]

  @@index([published, featured, sortOrder])
  @@index([industry])
  @@index([createdAt])
  @@index([authorId])
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  coverImage     String?
  tags           String[]
  category       String?
  seoTitle       String
  seoDescription String
  published      Boolean   @default(false)
  publishedAt    DateTime?
  authorId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  author         User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sites          Site[]

  @@index([published, publishedAt])
  @@index([category])
  @@index([createdAt])
  @@index([authorId])
}

model Lead {
  id               String           @id @default(cuid())
  siteId           String?
  name             String
  email            String
  phone            String?
  company          String?
  serviceType      ServiceType
  budgetRange      String?
  timeline         String?
  projectGoal      String
  message          String
  source           String
  preferredContact PreferredContact
  emailValid       Boolean          @default(true)
  phoneValid       Boolean          @default(true)
  status           LeadStatus       @default(NEW)
  internalNotes    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  site             Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  chatSessions     ChatSession[]

  @@index([siteId])
  @@index([status, createdAt])
  @@index([serviceType])
  @@index([source])
  @@index([email])
}

model ContactMessage {
  id            String               @id @default(cuid())
  siteId        String?
  name          String
  email         String
  phone         String?
  inquiryType   String?
  message       String
  sourcePage    String?
  status        ContactMessageStatus @default(NEW)
  internalNotes String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  site          Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([status, createdAt])
  @@index([email])
  @@index([inquiryType])
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  role       String?
  company    String?
  quote      String
  image      String?
  projectId  String?
  featured   Boolean  @default(false)
  published  Boolean  @default(false)
  sortOrder  Int      @default(0)
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sites      Site[]

  @@index([published, featured, sortOrder])
  @@index([projectId])
  @@index([authorId])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sites     Site[]

  @@index([published, sortOrder])
  @@index([category])
  @@index([authorId])
}

model ChatSession {
  id            String        @id @default(cuid())
  siteId        String?
  visitorId     String?
  leadId        String?
  summary       String?
  handedToHuman Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  site          Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]

  @@index([siteId])
  @@index([leadId])
  @@index([visitorId])
  @@index([handedToHuman, createdAt])
}

model ChatMessage {
  id        String          @id @default(cuid())
  sessionId String
  role      ChatMessageRole
  content   String
  createdAt DateTime        @default(now())
  session   ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  siteId    String?
  type      String    // "lead" | "message" | "chat"
  sourceId  String    // ID of the source record
  title     String
  detail    String
  href      String
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  site      Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([type, sourceId])
  @@index([siteId, read, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  siteId    String?
  siteSlug  String?
  eventType String
  page      String?
  referrer  String?
  source    String?
  device    String?
  country   String?
  metadata  Json?
  createdAt DateTime @default(now())
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([siteSlug])
  @@index([eventType, createdAt])
  @@index([page])
  @@index([source])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  siteId    String?
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([siteId, key])
  @@index([siteId])
  @@index([key])
}
