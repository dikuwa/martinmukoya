generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VISITOR
}

enum ServiceType {
  WEB_APP
  BOOKING_SYSTEM
  ECOMMERCE
  AI_AUTOMATION
  OTHER
}

enum PreferredContact {
  EMAIL
  PHONE
  WHATSAPP
}

enum LeadStatus {
  NEW
  REVIEWING
  CONTACTED
  QUALIFIED
  WON
  LOST
  ARCHIVED
}

enum BookingStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DocumentType {
  QUOTE
  INVOICE
  RECEIPT
}

enum DocumentStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  SUPERSEDED
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ChatMessageRole {
  VISITOR
  AI
  HUMAN
  SYSTEM
}

enum ChatMode {
  AI
  WAITING_FOR_HUMAN
  HUMAN
}

enum BusinessDocumentType {
  PROPOSAL
  SERVICE_AGREEMENT
  WEB_DESIGN_CONTRACT
  MAINTENANCE_AGREEMENT
  HOSTING_AGREEMENT
  SCOPE_OF_WORK
  PROJECT_BRIEF
  CHANGE_REQUEST
  PROJECT_HANDOVER
  CLIENT_ACCEPTANCE
  BUSINESS_LETTER
  PAYMENT_REMINDER
  OVERDUE_NOTICE
  MEETING_SUMMARY
  PROGRESS_REPORT
  AUDIT_REPORT
  MAINTENANCE_REPORT
  NDA
  CUSTOM
}

enum BusinessDocumentStatus {
  DRAFT
  READY
  ISSUED
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
  REVOKED
  ARCHIVED
}

enum BusinessDocumentAuditAction {
  CREATED
  EDITED
  AI_GENERATED
  AI_REWRITTEN
  ISSUED
  EMAILED
  WHATSAPP_SHARED
  LINK_COPIED
  VIEWED
  DOWNLOADED
  ACCEPTED
  DECLINED
  REVISED
  REVOKED
  ARCHIVED
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(VISITOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  blogPosts     BlogPost[]
  faqs          FAQ[]
  testimonials  Testimonial[]
  assignedChats ChatSession[] @relation("AssignedChatOperator")
  chatMessages  ChatMessage[] @relation("HumanChatMessages")
  cleanupRuns   CleanupRun[]
  financialBookings Booking[] @relation("BookingCreator")
  financialDocuments FinancialDocument[] @relation("DocumentCreator")
  recordedPayments Payment[] @relation("PaymentRecorder")
  createdContacts Contact[]
  createdBusinessDocuments BusinessDocument[]
  createdBusinessTemplates BusinessDocumentTemplate[]
}

model Site {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  primaryDomain   String?          @unique
  aliases         String[]
  brandConfig     Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projects        Project[]
  blogPosts       BlogPost[]
  faqs            FAQ[]
  testimonials    Testimonial[]
  leads           Lead[]
  contactMessages ContactMessage[]
  chatSessions    ChatSession[]
  analyticsEvents AnalyticsEvent[]
  settings        SiteSetting[]
  notifications   Notification[]
  financialBookings Booking[]
  financialDocuments FinancialDocument[]
  payments        Payment[]
  businessDocuments BusinessDocument[]
  documentSettings DocumentSettings[]

  @@index([slug])
  @@index([primaryDomain])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Project {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  summary          String
  description      String
  problem          String
  solution         String
  outcome          String?
  clientType       String?
  industry         String?
  eyebrow          String?
  timeline         String?
  role             String?
  deliverables     String[]      @default([])
  stackSummary     String?
  benefits         Json?
  capabilities     Json?
  coverImage       String?
  coverImageAlt    String?
  gallery          String[]
  galleryImages    Json?
  techStack        String[]
  services         String[]
  liveUrl          String?
  githubUrl        String?
  ctaEyebrow       String?
  ctaTitle         String?
  ctaDescription   String?
  ctaPrimaryLabel  String?
  ctaPrimaryUrl    String?
  ctaSecondaryLabel String?
  ctaSecondaryUrl   String?
  caseStudyContent String
  featured         Boolean       @default(false)
  published        Boolean       @default(false)
  sortOrder        Int           @default(0)
  authorId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  author           User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sites            Site[]
  testimonials     Testimonial[]

  @@index([published, featured, sortOrder])
  @@index([industry])
  @@index([createdAt])
  @@index([authorId])
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  coverImage     String?
  tags           String[]
  category       String?
  seoTitle       String
  seoDescription String
  published      Boolean   @default(false)
  publishedAt    DateTime?
  authorId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  author         User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sites          Site[]

  @@index([published, publishedAt])
  @@index([category])
  @@index([createdAt])
  @@index([authorId])
}

model Lead {
  id               String           @id @default(cuid())
  siteId           String?
  name             String
  email            String
  phone            String?
  whatsAppNumber   String?
  phoneIsWhatsApp  Boolean          @default(true)
  whatsAppConfirmed Boolean         @default(false)
  company          String?
  serviceType      ServiceType
  budgetRange      String?
  timeline         String?
  projectGoal      String
  message          String
  source           String
  preferredContact PreferredContact
  emailValid       Boolean          @default(true)
  phoneValid       Boolean          @default(true)
  status           LeadStatus       @default(NEW)
  internalNotes    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  site             Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  chatSessions     ChatSession[]
  financialBooking Booking?

  @@index([siteId])
  @@index([status, createdAt])
  @@index([serviceType])
  @@index([source])
  @@index([email])
}

model Contact {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  whatsAppNumber  String?
  phoneIsWhatsApp Boolean  @default(true)
  whatsAppConfirmed Boolean @default(false)
  company         String?
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([phone])
  @@index([name])
}

model Booking {
  id                 String        @id @default(cuid())
  number             String        @unique
  siteId             String
  leadId             String?       @unique
  customerName       String
  customerEmail      String?
  customerPhone      String?
  company            String?
  projectDescription String
  budgetRange        String?
  status             BookingStatus @default(ACTIVE)
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  site               Site          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  lead               Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy          User?         @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents          FinancialDocument[]
  payments           Payment[]

  @@index([siteId, createdAt])
  @@index([status, createdAt])
  @@index([customerName])
}

model FinancialDocument {
  id                    String         @id @default(cuid())
  number                String?        @unique
  type                  DocumentType
  status                DocumentStatus @default(DRAFT)
  siteId                String
  bookingId             String
  revisionOfId          String?
  convertedFromId       String?
  customerName          String
  customerEmail         String?
  customerPhone         String?
  customerCompany       String?
  customerAddress       String?
  issuerSnapshot        Json
  currency              String         @default("NAD")
  validUntil            DateTime?
  dueDate               DateTime?
  discountAmount        Decimal        @default(0) @db.Decimal(12, 2)
  additionalCharges     Decimal        @default(0) @db.Decimal(12, 2)
  taxRate               Decimal        @default(0) @db.Decimal(7, 4)
  subtotal              Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal        @default(0) @db.Decimal(12, 2)
  total                 Decimal        @default(0) @db.Decimal(12, 2)
  notes                 String?
  paymentTerms          String?
  issuedAt              DateTime?
  voidedAt              DateTime?
  shareToken            String?        @unique
  shareRevokedAt        DateTime?
  createdById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  site                  Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  booking               Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  revisionOf            FinancialDocument? @relation("DocumentRevisions", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions             FinancialDocument[] @relation("DocumentRevisions")
  convertedFrom         FinancialDocument? @relation("DocumentConversions", fields: [convertedFromId], references: [id], onDelete: SetNull)
  conversions           FinancialDocument[] @relation("DocumentConversions")
  createdBy             User?          @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems             DocumentLineItem[]
  payments              Payment[]      @relation("InvoicePayments")
  receiptForPayment     Payment?       @relation("PaymentReceipt")
  sharedDocument        SharedDocument?

  @@index([siteId, createdAt])
  @@index([bookingId, type, status])
  @@index([type, status, issuedAt])
}

model DocumentLineItem {
  id          String            @id @default(cuid())
  documentId  String
  description String
  category    String?
  quantity    Decimal           @db.Decimal(12, 3)
  unitPrice   Decimal           @db.Decimal(12, 2)
  amount      Decimal           @db.Decimal(12, 2)
  sortOrder   Int               @default(0)
  document    FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
}

model Payment {
  id                String            @id @default(cuid())
  number            String            @unique
  siteId            String
  bookingId         String
  invoiceId         String?
  receiptDocumentId String?           @unique
  amount            Decimal           @db.Decimal(12, 2)
  method            PaymentMethod
  paidAt            DateTime          @default(now())
  reference         String?
  notes             String?
  reversedAt        DateTime?
  recordedById      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  site              Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  invoice           FinancialDocument? @relation("InvoicePayments", fields: [invoiceId], references: [id], onDelete: Restrict)
  receiptDocument   FinancialDocument? @relation("PaymentReceipt", fields: [receiptDocumentId], references: [id], onDelete: Restrict)
  recordedBy        User?             @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([siteId, paidAt])
  @@index([bookingId, paidAt])
  @@index([invoiceId])
}

model ContactMessage {
  id            String               @id @default(cuid())
  siteId        String?
  name          String
  email         String
  phone         String?
  inquiryType   String?
  message       String
  sourcePage    String?
  status        ContactMessageStatus @default(NEW)
  internalNotes String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  site          Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([status, createdAt])
  @@index([email])
  @@index([inquiryType])
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  role       String?
  company    String?
  quote      String
  image      String?
  projectId  String?
  featured   Boolean  @default(false)
  published  Boolean  @default(false)
  sortOrder  Int      @default(0)
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sites      Site[]

  @@index([published, featured, sortOrder])
  @@index([projectId])
  @@index([authorId])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sites     Site[]

  @@index([published, sortOrder])
  @@index([category])
  @@index([authorId])
}

model ChatSession {
  id                 String        @id @default(cuid())
  siteId             String?
  visitorId          String?
  leadId             String?
  summary            String?
  mode               ChatMode     @default(AI)
  visitorToken       String        @unique @default(cuid())
  handoverRequestedAt DateTime?
  humanJoinedAt      DateTime?
  assignedAdminId    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  site               Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  lead               Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedAdmin      User?         @relation("AssignedChatOperator", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages           ChatMessage[]

  @@index([siteId])
  @@index([leadId])
  @@index([visitorId])
  @@index([mode, updatedAt])
  @@index([assignedAdminId])
}

model ChatMessage {
  id        String          @id @default(cuid())
  sessionId String
  role      ChatMessageRole
  content   String
  senderId  String?
  senderName String?
  createdAt DateTime        @default(now())
  session   ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    User?           @relation("HumanChatMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  siteId    String?
  type      String    // "lead" | "message" | "chat"
  sourceId  String    // ID of the source record
  title     String
  detail    String
  href      String
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  site      Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([type, sourceId])
  @@index([siteId, read, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  siteId    String?
  siteSlug  String?
  eventType String
  page      String?
  referrer  String?
  source    String?
  device    String?
  country   String?
  metadata  Json?
  createdAt DateTime @default(now())
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([siteSlug])
  @@index([eventType, createdAt])
  @@index([page])
  @@index([source])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  siteId    String?
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([siteId, key])
  @@index([siteId])
  @@index([key])
}

model CleanupRun {
  id             String    @id @default(cuid())
  adminId        String
  status         String    @default("EXPORTED")
  cutoffAt       DateTime
  expiresAt      DateTime
  exportedCounts Json
  deletedCounts  Json?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  admin          User      @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, status, createdAt])
  @@index([expiresAt])
}

model BusinessDocument {
  id                String                   @id @default(cuid())
  documentNumber    String?                  @unique
  documentType      BusinessDocumentType
  status            BusinessDocumentStatus   @default(DRAFT)
  title             String
  slug              String?                  @unique
  subject           String?
  siteId            String?
  contactId         String?
  leadId            String?
  projectId         String?
  serviceId         String?
  templateId        String?
  revisionOfId      String?

  companyName       String?
  recipientName     String?
  recipientEmail    String?
  recipientPhone    String?
  recipientWhatsApp String?

  issueDate         DateTime?
  expiryDate        DateTime?
  reviewDate        DateTime?

  contentMarkdown   String                   @default("")
  contentHtml       String?
  internalNotes     String?

  aiPromptContext   String?
  aiTone            String?
  aiStyle           String?
  aiLength          String?

  signatureRequired Boolean                  @default(false)
  senderName        String?
  senderRole        String?
  senderUserId      String?

  publicShare       SharedDocument?

  acceptedAt        DateTime?
  declinedReason    String?
  declinedComment   String?
  declinedAt        DateTime?
  revokedAt         DateTime?

  createdById       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  site              Site?                     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  template          BusinessDocumentTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  revisionOf        BusinessDocument?          @relation("BusinessDocumentRevisions", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions         BusinessDocument[]         @relation("BusinessDocumentRevisions")
  createdBy         User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  auditLog          BusinessDocumentAuditLog[]

  @@index([siteId, status, createdAt])
  @@index([documentType, status])
  @@index([slug])
  @@index([recipientEmail])
  @@index([createdById])
}

model BusinessDocumentTemplate {
  id                  String               @id @default(cuid())
  name                String               @unique
  documentCategory    BusinessDocumentType
  documentType        String?
  defaultTitle        String?
  defaultSubject      String?
  defaultBodyMarkdown String               @default("")
  aiInstructions      String?
  requiredSections    String[]             @default([])
  optionalSections    String[]             @default([])
  defaultTone         String               @default("Professional")
  defaultStyle        String               @default("Structured")
  defaultLength       String               @default("Medium")
  signatureRequired   Boolean              @default(false)
  senderName          String?
  senderRole          String?
  defaultEmailSubject String?
  defaultEmailBody    String?
  defaultWhatsAppMsg  String?
  headerFooterEnabled Boolean              @default(false)
  active              Boolean              @default(true)
  sortOrder           Int                  @default(0)
  createdById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdBy           User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  documents           BusinessDocument[]

  @@index([documentCategory, active])
  @@index([name])
}

model BusinessDocumentAuditLog {
  id         String                      @id @default(cuid())
  documentId String
  action     BusinessDocumentAuditAction
  detail     String?
  metadata   Json?
  userId     String?
  createdAt  DateTime                    @default(now())
  document   BusinessDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([action])
}

model SharedDocument {
  id               String    @id @default(cuid())
  shortCode        String    @unique
  documentType     String    // "financial" | "business"
  financialDocumentId String? @unique
  businessDocumentId  String? @unique
  passwordHash     String?
  shareEnabled     Boolean   @default(true)
  expiresAt        DateTime?
  firstViewedAt    DateTime?
  lastViewedAt     DateTime?
  viewCount        Int       @default(0)
  downloadCount    Int       @default(0)
  acceptedAt       DateTime?
  declinedAt       DateTime?
  declinedReason   String?
  acceptedName     String?
  acceptedComment  String?
  acceptedIp       String?
  acceptedUserAgent String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  financialDocument FinancialDocument? @relation(fields: [financialDocumentId], references: [id], onDelete: Cascade)
  businessDocument  BusinessDocument?  @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)

  @@index([shortCode])
  @@index([expiresAt])
  @@index([documentType])
}

model DocumentSettings {
  id                        String   @id @default(cuid())
  siteId                    String?  @unique
  defaultSenderName         String   @default("Martin Mukoya")
  defaultSenderRole         String   @default("Managing Director")
  defaultSignature          String   @default("")
  backdropEnabled           Boolean  @default(true)
  defaultBusinessExpiryDays Int      @default(30)
  defaultProposalValidity   Int      @default(30)
  defaultEmailSubject       String   @default("Document {{documentNumber}} from FlexTech Media")
  defaultEmailBody          String   @default("Hello {{recipientName}},\n\nPlease find the document below.\n\n{{shareLink}}\n\nRegards,\n{{senderName}}")
  defaultWhatsAppMsg        String   @default("Good afternoon {{recipientName}},\n\nPlease find your document below:\n{{shareLink}}\n\nRegards,\n{{senderName}}")
  aiDefaultTone             String   @default("Professional")
  aiDefaultStyle            String   @default("Structured")
  aiDefaultLength           String   @default("Medium")
  acceptanceEnabled         Boolean  @default(true)
  publicSharingDefaults     Json?    @default("{\"enabled\":true,\"expiryDays\":90}")
  trackingDefaults          Json?    @default("{\"trackViews\":true,\"trackDownloads\":true}")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  site                      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
}
