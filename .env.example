# Local and deployment environment variables.
# Copy this file to `.env.local` for local development.
# Never commit real secret values.

# Database: Supabase / Neon / Railway Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Upstash Redis: caching and rate limiting.
UPSTASH_REDIS_URL="https://<id>.upstash.io"
UPSTASH_REDIS_TOKEN=""

# Better Auth: session signing and app callback URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated list for extra deployment/domain origins.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Optional GitHub OAuth for sign-in.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email notifications via Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Martin Mukoya <info@martinmukoya.com>"

# AI assistant via OpenAI.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional AI fallback via OpenRouter if OpenAI is not configured.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
SITE_URL="https://martinmukoya.com"
SITE_NAME="Martin Mukoya"

# Optional Vercel AI Gateway if routing models through Vercel.
AI_GATEWAY_API_KEY=""

# PostHog analytics.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Cloudflare R2 for admin media uploads.
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_DEV_URL=""

# Optional alternative upload provider. Not used when Cloudflare R2 is configured.
UPLOADTHING_TOKEN=""

# Public URLs used for links, canonical metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL="https://martinmukoya.com"
NEXT_PUBLIC_FLEXTECH_SITE_URL="https://flextech-media.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial admin seed account.
ADMIN_NAME="Martin Mukoya"
ADMIN_EMAIL="info@martinmukoya.com"
ADMIN_PASSWORD=""
