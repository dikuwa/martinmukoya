# Database connection string for Neon/PostgreSQL.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Upstash Redis REST URL used for API-layer caching.
UPSTASH_REDIS_URL="https://<id>.upstash.io"

# Upstash Redis REST token used for API-layer caching.
UPSTASH_REDIS_TOKEN=""

# 32+ character Better Auth secret for session signing.
BETTER_AUTH_SECRET=""

# Canonical application URL for Better Auth callbacks.
BETTER_AUTH_URL="http://localhost:3000"

# Optional GitHub OAuth app credentials for admin sign-in.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Resend API key for contact and lead notifications.
RESEND_API_KEY=""

# Verified sender used by Resend emails.
RESEND_FROM_EMAIL="Martin Mukoya <info@martinmukoya.com>"

# Vercel AI SDK provider key for the portfolio assistant.
OPENAI_API_KEY=""

# Optional Vercel AI Gateway key if routing through AI Gateway.
AI_GATEWAY_API_KEY=""

# PostHog browser project key for conversion analytics.
NEXT_PUBLIC_POSTHOG_KEY=""

# PostHog host, usually https://us.i.posthog.com or https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Cloudflare R2 credentials for production asset uploads.
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_DEV_URL=""

# Optional UploadThing token if using UploadThing instead of R2.
UPLOADTHING_TOKEN=""

# Public app URL used for links and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial admin seed account.
ADMIN_NAME="Martin Mukoya"
ADMIN_EMAIL="info@martinmukoya.com"
ADMIN_PASSWORD=""
